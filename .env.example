# ==========================================
# Konfiguracja Bazy Danych PostgreSQL
# ==========================================
# Pełny URL połączenia do bazy PostgreSQL:
DATABASE_URL=postgresql://postgres:twoje_haslo@localhost:5432/mtg_db?sslmode=disable

# LUB poszczególne parametry (gdy DATABASE_URL nie jest podany):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=mtg_db
# PGUSER=postgres
# PGPASSWORD=twoje_haslo
# PGSSLMODE=disable

# ==========================================
# Bezpieczeństwo i Sesje
# ==========================================
# WYMAGANE (min. 32 znaki). Wygeneruj: openssl rand -base64 48
JWT_SECRET=
PORT=3000

# ==========================================
# Gemini AI Vision (Skaner Kart i Asystent MTG)
# Wstrzykiwany automatycznie w środowisku AI Studio
# ==========================================
GEMINI_API_KEY=
