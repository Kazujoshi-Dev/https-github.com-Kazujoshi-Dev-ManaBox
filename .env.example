# ==========================================
# Plik .env dla docker-compose.yml (skopiuj jako .env i uzupełnij).
# NIGDY nie commituj pliku .env — jest w .gitignore.
# ==========================================

# --- PostgreSQL ---
# Hasło jest ustawiane tylko przy PIERWSZYM uruchomieniu bazy (pusty wolumen).
# Przy istniejącej bazie wpisz obecne hasło.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mtg_db

# Adres bazy dla aplikacji (host "db" to nazwa usługi w docker-compose).
# Użytkownik/hasło/baza muszą zgadzać się z wartościami powyżej.
DATABASE_URL=postgresql://postgres:HASLO@db:5432/mtg_db?sslmode=disable

# --- Bezpieczeństwo ---
# WYMAGANE (min. 32 znaki). Wygeneruj: openssl rand -base64 48
JWT_SECRET=

# --- Panel administratora ---
# Adresy e-mail kont z dostępem do zakładki „Admin” (oddzielone przecinkami)
ADMIN_EMAILS=
# Dodatkowe wersje językowe kart w lokalnej bazie (kody Scryfall oddzielone przecinkami).
# Domyślnie "ja" (japońskie). Pusta wartość = tylko angielskie. Pobierane z pliku all_cards Scryfall.
CARD_EXTRA_LANGS=ja

# --- Uruchamianie lokalne bez Dockera (npm run dev) ---
# Zamiast DATABASE_URL można podać osobne parametry:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=mtg_db
# PGUSER=postgres
# PGPASSWORD=
# PGSSLMODE=disable
