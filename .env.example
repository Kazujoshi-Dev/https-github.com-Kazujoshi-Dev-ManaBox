# ==========================================
# Plik .env dla docker-compose.yml (skopiuj jako .env i uzupełnij).
# NIGDY nie commituj pliku .env — jest w .gitignore.
# ==========================================

# --- PostgreSQL ---
# Hasło jest ustawiane tylko przy PIERWSZYM uruchomieniu bazy (pusty wolumen).
# Przy istniejącej bazie wpisz obecne hasło.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mtg_db

# Adres bazy dla aplikacji (host "db" to nazwa usługi w docker-compose).
# Użytkownik/hasło/baza muszą zgadzać się z wartościami powyżej.
DATABASE_URL=postgresql://postgres:HASLO@db:5432/mtg_db?sslmode=disable

# --- Bezpieczeństwo ---
# WYMAGANE (min. 32 znaki). Wygeneruj: openssl rand -base64 48
JWT_SECRET=

# --- Panel administratora ---
# Adresy e-mail kont z dostępem do zakładki „Admin” (oddzielone przecinkami)
ADMIN_EMAILS=
# Dodatkowe wersje językowe kart w lokalnej bazie (kody Scryfall oddzielone przecinkami).
# Domyślnie "ja,ph" (japońskie i phyrexian). Pusta wartość = tylko angielskie. Pobierane z pliku all_cards Scryfall.
CARD_EXTRA_LANGS=ja,ph

# --- Uruchamianie lokalne bez Dockera (npm run dev) ---
# Zamiast DATABASE_URL można podać osobne parametry:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=mtg_db
# PGUSER=postgres
# PGPASSWORD=
# PGSSLMODE=disable

# Adres strony używany w sitemap.xml, linkach kanonicznych, Open Graph i linkach w e-mailach (domyślnie https://manascrew.eu)
# PUBLIC_SITE_URL=https://manascrew.eu

# --- E-mail (SMTP, np. Brevo): potwierdzenie rejestracji i reset hasła ---
# Bez SMTP_HOST/SMTP_USER/SMTP_PASSWORD konta działają bez potwierdzania e-mail, a reset hasła przez e-mail jest wyłączony.
# SMTP_PASSWORD to klucz SMTP z panelu Brevo (SMTP & API -> SMTP). Nie wklejaj go nigdzie poza plikiem .env na serwerze.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Mana Screw <noreply@manascrew.eu>
