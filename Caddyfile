manascrew.eu {
	encode zstd gzip
	reverse_proxy app:3000 {
		# Podczas `docker compose up -d --build` kontener aplikacji startuje kilka sekund.
		# Zamiast zwracać 502, Caddy wstrzymuje zapytania i ponawia je, aż aplikacja wstanie.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# Jeden adres dla wyszukiwarek: www przekierowujemy na domenę główną (308 zachowuje metodę i treść zapytania).
www.manascrew.eu {
	redir https://manascrew.eu{uri} 308
}
